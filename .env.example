# 32+ characters. Generated automatically into data/session.key if unset.
# On Vercel, set this or sign-in cookies reset when a new server starts.
GRIZZLY_SESSION_PASSWORD=

# Fixed staff accounts. Only hashes are stored in SQLite.
GRIZZLY_OWNER_USER=owner
GRIZZLY_OWNER_PASSWORD="Grizzly#Owner26"
GRIZZLY_KITCHEN1_USER=kitchen.outlet1
GRIZZLY_KITCHEN1_PASSWORD="Grizzly#Kitchen1"
GRIZZLY_KITCHEN2_USER=kitchen.outlet2
GRIZZLY_KITCHEN2_PASSWORD="Grizzly#Kitchen2"

# Interakt WhatsApp (server-side only — never prefix with VITE_)
# Paste the Secret Key from Interakt → Settings → Developer Setting.
INTERAKT_API_KEY=
INTERAKT_API_BASE_URL=https://api.interakt.ai
INTERAKT_ENABLED=false
INTERAKT_DEFAULT_COUNTRY_CODE=+91
INTERAKT_OTP_TEMPLATE=grizzly_login_otp
# Must match the template language in Meta/Interakt exactly (your template is en).
INTERAKT_OTP_LANG=en
INTERAKT_ORDER_CONFIRMATION_TEMPLATE=order_confirmation__grizzly_pizzeria
INTERAKT_ORDER_CONFIRMATION_APPROVED=false
INTERAKT_MARKETING_TEMPLATE=grizzly_weekend_offer
INTERAKT_MARKETING_APPROVED=false
# Shared secret you configure in Interakt Developer Settings for webhooks.
INTERAKT_WEBHOOK_SECRET=
# Optional 10-digit Indian mobile for npm run test:interakt live smoke.
INTERAKT_TEST_PHONE=

# Razorpay (server-side only — never prefix with VITE_)
# Paste the Test Key ID and Test Key Secret from Razorpay Dashboard → Account & Settings → API Keys.
# Leave MODE=test until you are ready to take real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
